# Udev rules to create stable /dev/ORCL_DISK<N>_p1 and _p2 symlinks for ASM.
# Generated by Ansible — do not edit by hand.
{% for disk in asm_disks %}
{% set idx = loop.index %}
# Disk {{ idx }}: /dev/{{ disk }}
KERNEL=="{{ disk }}1", SUBSYSTEM=="block", ACTION=="add|change", SYMLINK+="ORCL_DISK{{ '%02d' % idx }}_p1", OWNER="grid", GROUP="asmadmin", MODE="0660"
KERNEL=="{{ disk }}2", SUBSYSTEM=="block", ACTION=="add|change", SYMLINK+="ORCL_DISK{{ '%02d' % idx }}_p2", OWNER="grid", GROUP="asmadmin", MODE="0660"
{% endfor %}
