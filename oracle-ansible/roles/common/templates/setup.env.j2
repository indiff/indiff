# /etc/opt/oracle-rac/setup.env — generated by Ansible
# Source this file before any Oracle admin command.

export PREFIX_NAME="{{ prefix_name | default('rac19') }}"
export DOMAIN_NAME="{{ domain_name }}"
export CLUSTER_NAME="{{ cluster_name | default('') }}"

export GI_SOFTWARE="{{ gi_software }}"
export DB_SOFTWARE="{{ db_software }}"
export GI_VERSION="{{ gi_version }}"
export DB_VERSION="{{ oracle_version }}"
export DB_MAJOR="{{ db_major }}"

export ORA_INVENTORY="{{ ora_inventory }}"
export GRID_BASE="{{ grid_base }}"
export DB_BASE="{{ oracle_base }}"
export GI_HOME="{{ gi_home }}"
export DB_HOME="{{ db_home }}"
export ORA_LANGUAGES="{{ ora_languages }}"

export P1_RATIO="{{ p1_ratio }}"
export ASM_DISK_NUM="{{ asm_disk_num }}"
export NOMGMTDB="{{ nomgmtdb | string | lower }}"
export ORESTART="{{ orestart | string | lower }}"

{% set all_nodes = (groups['rac_primary'] | default([])) + (groups['rac_standby'] | default([])) + (groups['adg_primary'] | default([])) + (groups['adg_standby'] | default([])) %}
{% for host in all_nodes %}
{% set hv = hostvars[host] %}
{% set idx = loop.index %}
export NODE{{ idx }}_HOSTNAME="{{ host }}"
export NODE{{ idx }}_PUBLIC_IP="{{ hv.public_ip | default('') }}"
export NODE{{ idx }}_PRIV_IP="{{ hv.private_ip | default('') }}"
export NODE{{ idx }}_VIP_IP="{{ hv.vip_ip | default('') }}"
export NODE{{ idx }}_FQ_HOSTNAME="{{ host }}.{{ domain_name }}"
export NODE{{ idx }}_VIPNAME="{{ host }}-vip"
export NODE{{ idx }}_FQ_VIPNAME="{{ host }}-vip.{{ domain_name }}"
export NODE{{ idx }}_PRIVNAME="{{ host }}-priv"
export NODE{{ idx }}_FQ_PRIVNAME="{{ host }}-priv.{{ domain_name }}"
{% endfor %}

export SCAN_NAME="{{ scan_name | default('') }}"
export FQ_SCAN_NAME="{{ scan_name | default('') }}.{{ domain_name }}"
export SCAN_PORT="{{ scan_port | default(1521) }}"
export SCAN_IP1="{{ scan_ip1 | default('') }}"
export SCAN_IP2="{{ scan_ip2 | default('') }}"
export SCAN_IP3="{{ scan_ip3 | default('') }}"

export DB_NAME="{{ db_name }}"
export PDB_NAME="{{ pdb_name | default('') }}"
export DB_TYPE="{{ db_type }}"
export CDB="{{ cdb | string | lower }}"
export ARCH_TYPE="{{ arch_type }}"
export ADG_ROLE="{{ adg_role | default('') }}"

# Terminal colour tags — values use Chinese prefixes to match the original shell
# script conventions (信息=Info, 错误=Error, 成功=Success).
export INFO='\033[0;34m信息：\033[0m'
export ERROR='\033[1;31m错误：\033[0m'
export SUCCESS='\033[1;32m成功：\033[0m'
